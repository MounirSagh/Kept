NODE_ENV=development

# Postgres (docker compose)
POSTGRES_USER=kept
POSTGRES_PASSWORD=kept
POSTGRES_DB=kept
POSTGRES_PORT=5432

# Redis (docker compose)
REDIS_PORT=6379

# Connection strings used by apps running on the host
DATABASE_URL=postgresql://kept:kept@localhost:5432/kept
REDIS_URL=redis://localhost:6379

# Apps
API_PORT=4000
WEB_PORT=5173
WORKER_CONCURRENCY=5
WEB_ORIGIN=http://localhost:5173

# Clerk (dashboard → API keys / Webhooks)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=
