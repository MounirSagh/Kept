NODE_ENV=development

# Postgres (docker compose)
POSTGRES_USER=kept
POSTGRES_PASSWORD=kept
POSTGRES_DB=kept
POSTGRES_PORT=5432

# Redis (docker compose)
REDIS_PORT=6379

# Connection strings used by apps running on the host
DATABASE_URL=postgresql://kept:kept@localhost:5432/kept
REDIS_URL=redis://localhost:6379

# Apps
API_PORT=4000
WEB_PORT=5173
WORKER_CONCURRENCY=5
# How far back a tool's first sync reaches, in hours (default 2160, i.e. 90 days). Lower it to try Kept on a busy mailbox.
SYNC_BACKFILL_HOURS=2160
WEB_ORIGIN=http://localhost:5173

# Clerk (dashboard → API keys / Webhooks)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=

# Email (Resend), sent by the worker with retries; the API only queues. Both read the key.
# Without a key, emails are logged and the app shows the invite link to share.
# The default sender (onboarding@resend.dev) only delivers to your own Resend account email;
# verify a domain in Resend and set EMAIL_FROM (e.g. "Kept <invites@yourdomain.com>") to email anyone.
RESEND_API_KEY=
EMAIL_FROM=

# OpenAI (generation and embeddings). Embedding model is fixed per deployment:
# changing it means re-embedding every memory (DurableHMEM.reembedPending).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Extraction and investigation use the fast model; planning, criticism and advice the smart one.
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_SMART_MODEL=gpt-5
# How long reasoning models think: minimal, low, medium or high. Higher is slower and costs more.
OPENAI_REASONING_EFFORT=low

# Optional: trace every agent run in LangSmith (the trace id is the agent run's id).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kept

# Connectors. TOKEN_ENCRYPTION_KEY encrypts stored OAuth tokens: generate with
# `openssl rand -base64 32` and never change it (existing connections would need reconnecting).
TOKEN_ENCRYPTION_KEY=
# OAuth apps, one per provider. Redirect URI to register for all of them: <WEB_ORIGIN>/oauth/callback
# Providers without both values show as "Not set up" on the Integrations page. See docs/connectors.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
