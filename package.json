{
  "name": "kept",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:down": "docker compose --profile app down",
    "db:generate": "pnpm --filter @kept/db db:generate",
    "db:migrate": "pnpm --filter @kept/db db:migrate",
    "db:deploy": "pnpm --filter @kept/db db:deploy",
    "db:studio": "pnpm --filter @kept/db db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "express": "^5.3.0"
  }
}
